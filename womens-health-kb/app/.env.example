# --- Database (Supabase or any Postgres with pgvector) ---
DATABASE_URL=postgresql://user:password@host:5432/whkb

# --- Access: single shared password gate ---
SITE_PASSWORD=change-me
# A long random string used to sign the auth cookie.
AUTH_SECRET=change-me-to-a-long-random-string

# --- AI providers (Autoploy keys during build; swap to client's on handoff) ---
OPENAI_API_KEY=sk-...              # embeddings (text-embedding-3-small, 1536-dim)
ANTHROPIC_API_KEY=sk-ant-...       # chatbot answer generation
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=claude-3-5-sonnet-latest
