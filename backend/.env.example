DATABASE_URL=sqlite:///./pokemon_tracker.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@example.com
FRONTEND_ORIGIN=http://localhost:3000
SYNC_INTERVAL_HOURS=3
HOT_SYNC_TOP_N=100
HOT_SYNC_INTERVAL_MINUTES=15
RUN_FULL_SYNC_ON_STARTUP=true
DISABLE_SCHEDULER=false
LOG_LEVEL=INFO
MAX_TRACKED_CARDS=500
SYNC_PERSIST_BATCH_SIZE=25

# Safety controls for public SNKRDUNK fetching. Keep these conservative for large
# syncs to reduce rate-limit risk.
SYNC_FETCH_WORKERS=2
SNKRDUNK_REQUEST_DELAY_SECONDS=0.7
SNKRDUNK_REQUEST_JITTER_SECONDS=0.6
SNKRDUNK_COOLDOWN_SECONDS=1800
SNKRDUNK_USE_PLAYWRIGHT=true
SNKRDUNK_PLAYWRIGHT_TIMEOUT_SECONDS=30
# Use the real Chrome channel and a persistent browser profile when SNKRDUNK
# blocks plain HTTP requests. Run `node scripts/snkrdunk_login.mjs` once to log
# into this profile, then keep these values for scheduled syncs.
SNKRDUNK_PLAYWRIGHT_CHANNEL=chrome
SNKRDUNK_PLAYWRIGHT_HEADLESS=true
SNKRDUNK_PLAYWRIGHT_USER_DATA_DIR=.snkrdunk-playwright-profile

# OPTIONAL: paste a "Copy as cURL (bash)" string from any /en/v1/... request in your
# logged-in SNKRDUNK browser session here (single-quoted, one line). When set, the
# scraper unlocks the authenticated /sale-prices endpoint, which returns sold-at
# timestamps for a real SNKRDUNK-style price chart and accurate sold-prices for rare
# grades. Leave empty to use the public used-listings feed only.
SNKRDUNK_BROWSER_CURL=
